# Copy to frontend/.env and fill in real values. Never commit frontend/.env.

# Base URL of the backend API (no trailing slash), e.g. http://localhost:8000
# Used by WassimAIPage.js to call POST {REACT_APP_BACKEND_URL}/api/wassim-chat
REACT_APP_BACKEND_URL=

# --- Premium activation (frontend/src/utils/premiumManager.js) ---
# WARNING: this is a Create React App project. Every REACT_APP_* variable is
# compiled into the public JS bundle at build time — it is NOT secret and is
# readable by anyone who opens the built app. Setting these here only keeps
# the values out of committed source and lets you rotate them by redeploying
# instead of editing code. Real confidentiality requires moving validation to
# the backend (Phase 2 — see PLAN.md). Do not treat this as a security fix.

# The magic-link activation code, e.g. used as /?activate=THIS_VALUE
REACT_APP_MAGIC_LINK_CODE=

# Comma-separated list of valid manual-entry premium keys, e.g. KEY1,KEY2,KEY3
REACT_APP_VALID_PREMIUM_KEYS=

# BaridiMob RIP (bank account number) shown to buyers on the payment screen.
# This is displayed publicly in the app UI by design (buyers need it to pay),
# so this env var only avoids hardcoding it in source — it is not a secret.
REACT_APP_PAYMENT_RIP=
