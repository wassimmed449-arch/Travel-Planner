# Copy to frontend/.env and fill in real values. Never commit frontend/.env.

# Base URL of the backend API (no trailing slash), e.g. http://localhost:8000
# Used by WassimAIPage.js to call POST {REACT_APP_BACKEND_URL}/api/wassim-chat
REACT_APP_BACKEND_URL=

# Set to "true" to enable the local dev-server health check webpack plugin
# (frontend/plugins/health-check). Leave unset/false for normal development.
ENABLE_HEALTH_CHECK=
