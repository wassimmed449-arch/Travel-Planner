# Copy to backend/.env and fill in real values. Never commit backend/.env.

# MongoDB connection string, e.g. mongodb://localhost:27017 or an Atlas SRV URI.
MONGO_URL=

# Name of the MongoDB database this app should use.
DB_NAME=

# Google Gemini API key used by the /api/wassim-chat endpoint (via the
# google-genai SDK). Get one from https://aistudio.google.com/apikey.
# The backend fails fast at startup if this is missing.
GEMINI_API_KEY=

# Gemini model to use. Optional - defaults to gemini-3.6-flash if unset.
# Google periodically retires older model names (gemini-2.0-flash was
# retired in favor of gemini-3.6-flash as of this writing); override here
# instead of editing code when that happens again.
GEMINI_MODEL=

# Comma-separated list of allowed CORS origins, e.g. https://example.com,https://www.example.com
# Do not use * in production.
CORS_ORIGINS=

# --- Server-side premium validation (Phase 2) ---
# These are backend-only (no REACT_APP_ prefix) - unlike their Phase 0
# frontend equivalents, these never ship to the browser. This is the actual
# fix for the key-exposure issue in AUDIT.md §2.
#
# Comma-separated list of valid premium keys, one per purchase, e.g.
# KEY-ONE,KEY-TWO,KEY-THREE. Seeded into MongoDB (db.premium_keys) once at
# backend startup; already-activated keys are never overwritten by a
# redeploy, so this is safe to leave set permanently. To sell a new key,
# add it here and redeploy, or insert a document into db.premium_keys
# directly ({_id: "NEWKEY", key: "NEWKEY", device_id: null, revoked: false}).
VALID_PREMIUM_KEYS=

# The magic-link activation code, e.g. used as /?activate=THIS_VALUE.
# Also seeded into db.premium_keys at startup, validated through the same
# /api/activate-premium path as a manually-entered key.
MAGIC_LINK_CODE=
